<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= profile.name %> — Pakistani Open-Source <%= isPerson ? 'Developer' : 'Organization' %> | Awesome Pakistan</title>
  <meta name="description" content="<%= profile.name %> is listed in the Awesome Pakistan directory with public GitHub profile and technology focus: <%= profile.technologies.join(', ') %>.">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="canonical" href="<%= profile.profile_url %>">
  <meta property="og:type" content="<%= isPerson ? 'profile' : 'website' %>">
  <meta property="og:title" content="<%= profile.name %> | Awesome Pakistan">
  <meta property="og:description" content="Public profile in the Pakistani open-source directory: <%= profile.technologies.join(', ') %>.">
  <meta property="og:url" content="<%= profile.profile_url %>">
  <meta property="og:image" content="<%= metadata.canonical_url %>assets/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="../../assets/styles.css">
  <script type="application/ld+json"><%- jsonForHtml(jsonLd) %></script>
</head>
<body class="profile-page">
  <header class="site-header">
    <a class="brand" href="../../" aria-label="Awesome Pakistan home">
      <span class="brand-mark" aria-hidden="true">PK</span>
      <span>Awesome Pakistan</span>
    </a>
    <a class="header-link" href="<%= metadata.repository_url %>">View source on GitHub</a>
  </header>

  <main class="profile-main">
    <nav aria-label="Breadcrumb"><a href="../../">Directory</a> <span aria-hidden="true">/</span> <span><%= profile.section %></span></nav>
    <article class="profile-detail">
      <p class="eyebrow"><%= profile.section %></p>
      <h1><%= profile.name %></h1>
      <% if (profile.github_user) { %><p class="profile-handle"><a href="<%= profile.github_link %>">@<%= profile.github_user %> on GitHub</a></p><% } %>
      <h2>Technologies and focus</h2>
      <ul class="technology-list technology-list-large">
        <% for (const technology of profile.technologies) { %><li><%= technology %></li><% } %>
      </ul>
      <div class="profile-actions">
        <% if (profile.github_link) { %><a class="button button-primary" href="<%= profile.github_link %>">View GitHub profile</a><% } %>
        <a class="button button-secondary" href="<%= profile.web %>">Visit <%= profile.name %> website</a>
      </div>
      <aside class="verification-note">
        <h2>About this listing</h2>
        <p>This entry uses publicly submitted profile information. Inclusion is not a ranking or endorsement. Last dataset update: <%= metadata.last_updated %>.</p>
        <p><a href="<%= metadata.repository_url %>/issues">Suggest a correction or request removal</a>.</p>
      </aside>
    </article>
  </main>

  <footer>
    <p>Awesome Pakistan · <a href="../../">Browse all profiles</a></p>
    <p><a href="<%= metadata.repository_url %>">Source and revision history</a></p>
  </footer>
</body>
</html>
