<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pakistani Open-Source Developers and Organizations | Awesome Pakistan</title>
  <meta name="description" content="Discover Pakistani open-source developers, GitHub contributors, software organizations, technology communities, and open-source events.">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <link rel="canonical" href="<%= metadata.canonical_url %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Pakistani Open-Source Developers and Organizations">
  <meta property="og:description" content="A community-maintained directory of Pakistan's open-source technology ecosystem.">
  <meta property="og:url" content="<%= metadata.canonical_url %>">
  <meta property="og:image" content="<%= metadata.canonical_url %>assets/og-v2.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Pakistani Open-Source Developers and Organizations">
  <meta name="twitter:description" content="Explore public profiles across Pakistan's open-source technology ecosystem.">
  <meta name="twitter:image" content="<%= metadata.canonical_url %>assets/og-v2.png">
  <link rel="stylesheet" href="assets/styles.css">
  <script type="application/ld+json"><%- jsonForHtml(jsonLd) %></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="./" aria-label="Awesome Pakistan home">
      <span class="brand-mark" aria-hidden="true">PK</span>
      <span>Awesome Pakistan</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class="contribute-link" href="<%= metadata.repository_url %>/blob/03dd22f25504e379623d60186aab7f641deebc1b/CONTRIBUTING.md">Add or correct an entry</a>
      <a class="github-link" href="<%= metadata.repository_url %>"><%- githubIcon %><span>GitHub</span></a>
    </nav>
  </header>

  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-copy">
        <p class="eyebrow">Pakistan's open-source directory</p>
        <h1 id="page-title">Discover Pakistan's open-source ecosystem.</h1>
        <p class="lede">Search Pakistani developers, organizations, communities, and technologies.</p>
      </div>
      <dl class="stats" aria-label="Directory statistics">
        <div><dt><%= counts.total %></dt><dd>public profiles</dd></div>
        <div><dt><%= counts.developers %></dt><dd>developers</dd></div>
        <div><dt><%= counts.organizations %></dt><dd>organizations</dd></div>
        <div><dt><%= counts.communities %></dt><dd>communities and events</dd></div>
      </dl>

      <div class="filters" role="search" aria-label="Search the directory">
        <label>
          <span>Search profiles</span>
          <input id="directory-search" type="search" placeholder="Try Python, React, AI, or a name" autocomplete="off">
        </label>
        <label>
          <span>Category</span>
          <select id="directory-category">
            <option value="all">All categories</option>
            <% for (const section of awesome) { %>
            <option value="<%= slugify(section.type) %>"><%= section.type %></option>
            <% } %>
          </select>
        </label>
      </div>
    </section>

    <section class="directory" id="directory" aria-labelledby="directory-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">58 public profiles</p>
          <h2 id="directory-title">Browse the directory</h2>
        </div>
        <p>Search names, GitHub handles, technologies, and categories.</p>
      </div>

      <p class="results-summary" id="results-summary" aria-live="polite">Showing all <%= counts.total %> profiles.</p>

      <% for (const section of awesome) { %>
      <section class="directory-group" data-directory-group="<%= slugify(section.type) %>">
        <div class="group-heading">
          <h3><%= section.type %></h3>
          <span><%= section.profiles.length %> entries</span>
        </div>
        <div class="profile-grid">
          <% for (const profile of section.profiles) { const slug = slugify(profile.github_user || profile.name); %>
          <article class="profile-card" data-profile data-category="<%= slugify(section.type) %>" data-search="<%= [profile.name, profile.github_user, section.type, ...profile.technologies].join(' ').toLowerCase() %>">
            <div class="profile-card-heading">
              <h4><a href="profiles/<%= slug %>/"><%= profile.name %></a></h4>
              <% if (profile.github_user) { %><a class="handle" href="<%= profile.github_link %>"><%- githubIcon %>@<%= profile.github_user %></a><% } %>
            </div>
            <ul class="technology-list" aria-label="Technologies">
              <% for (const technology of profile.technologies) { %><li><%- technologyIcon(technology) %><span><%= technology %></span></li><% } %>
            </ul>
            <a class="profile-link" href="profiles/<%= slug %>/">View profile <span aria-hidden="true">→</span></a>
          </article>
          <% } %>
        </div>
      </section>
      <% } %>

      <div class="empty-state" id="empty-state" hidden>
        <h3>No matching profiles</h3>
        <p>Try a broader technology, name, or category.</p>
      </div>
    </section>

    <section class="about" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">Transparent by design</p>
        <h2 id="about-title">Public data, clear criteria, community corrections.</h2>
      </div>
      <div class="about-copy">
        <p>Entries are based on public profiles and are not rankings or endorsements. The source dataset, schema, validation rules, and revision history are available on GitHub.</p>
        <p><a href="data/awesome-pakistani.json">Download the JSON dataset</a> · <a href="awesome-data.schema.json">View the JSON Schema</a> · <a href="<%= metadata.repository_url %>/issues">Request a correction</a></p>
      </div>
    </section>
  </main>

  <footer>
    <p>Awesome Pakistan · Updated <%= metadata.last_updated %> · <a href="<%= metadata.repository_url %>/blob/master/LICENSE">MIT License</a></p>
    <p><a href="<%= metadata.repository_url %>">GitHub</a> · <a href="<%= metadata.repository_url %>/blob/master/CITATION.cff">Cite this dataset</a></p>
  </footer>

  <script src="assets/app.js" defer></script>
</body>
</html>
